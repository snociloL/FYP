{
  "manifest_version": 3,
  "name": "Deepfake Video Validator",
  "version": "3.0",
  "description": "Validates videos for AI manipulation using ResNet-50 + LSTM via local Python backend.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://snocilol-deepfake-validator.hf.space/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html", "offscreen.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["indicator.css"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Deepfake Validator",
    "default_popup": "analyzer.html"
  }
}
