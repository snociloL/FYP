{
  "manifest_version": 3,
  "name": "Deepfake Video Validator",
  "version": "1.0",
  "description": "Validates web videos for AI manipulation using ResNet-50 and LSTM.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "web_accessible_resources": [
    {
      "resources": ["sandbox.html", "lib/tf.min.js", "sandbox.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Deepfake Validator Status"
  }
}